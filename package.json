{
  "name": "devilsrock.de",
  "private": true,
  "type": "module",
  "description": "Devils Rock Trails website on Cloudflare Workers",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "serve": "python3 -m http.server 8000",
    "test": "node --test worker/test/*.test.js",
    "package": "npm run build && node scripts/package-site.mjs",
    "deploy": "npm run package && wrangler deploy --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.4.0"
  }
}
