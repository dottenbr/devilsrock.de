{
  "name": "devilsrock-forms",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Cloudflare serves the complete site, including API routes.
  "routes": [
    { "pattern": "www.devilsrock.de", "custom_domain": true },
    { "pattern": "devilsrock.de", "custom_domain": true }
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  // Sends from send.devilsrock.de (onboarded to Cloudflare Email Sending).
  // The root domain keeps its iCloud MX/SPF records untouched.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFb0zkdZ2vEXsFct",
    "REPORT_TO": "dottenbr@me.com",
    "REPORT_FROM": "trails@send.devilsrock.de",
    "ALLOWED_ORIGINS": "https://www.devilsrock.de,https://devilsrock.de"
  },
  // 5 reports per minute per IP
  "ratelimits": [
    { "name": "COMMUNITY_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "REPORT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
