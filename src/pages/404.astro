---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Seite nicht gefunden" description="Diese Seite gibt es auf devilsrock.de nicht." noindex>
    <PageHeader eyebrow="Fehler 404" title="Falsch abgebogen" subtitle="Diese Seite gibt es leider nicht. Vielleicht hat sich die Adresse geändert, oder der Link war fehlerhaft. Hier geht's zurück auf den Trail:">
        <div class="btn-row actions">
            <a href="/" class="btn btn-primary"><Icon name="house" /> Zur Startseite</a>
            <a href="/#trail" class="btn btn-ghost"><Icon name="route" /> Routen und GPX</a>
            <a href="/schaden-melden/" class="btn btn-ghost"><Icon name="triangle-exclamation" /> Schaden melden</a>
        </div>
    </PageHeader>
</Base>

<style>
    .actions {
        margin-top: 1.75rem;
    }
</style>
