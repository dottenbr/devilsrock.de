---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Schaden melden" description="Melde Schäden, Gefahrenstellen oder blockierte Abschnitte auf den Devils Rock Trails, gern mit Fotos.">
    <PageHeader eyebrow="Trailpflege" title="Schaden melden" subtitle="Umgestürzter Baum, ausgespülte Kurve, kaputtes Schild? Sag uns Bescheid, dann kümmern wir uns darum." />

    <section class="section">
        <div class="container report">
            <div class="card">
                <div class="form-result form-success" id="gesendet" role="status">
                    <Icon name="circle-check" />
                    <div>
                        <strong>Danke für deine Meldung!</strong>
                        <p>Wir haben sie erhalten und kümmern uns darum. Bei Rückfragen melden wir uns bei dir.</p>
                    </div>
                </div>
                <div class="form-result form-error" id="fehler" role="alert">
                    <Icon name="triangle-exclamation" />
                    <div>
                        <strong>Das hat leider nicht geklappt.</strong>
                        <p>Bitte versuche es erneut oder schreib direkt an <a href="mailto:dom@devilsrock.de?subject=Schadenmeldung%20Devils%20Rock%20Trails">dom@devilsrock.de</a>.</p>
                    </div>
                </div>

                <form id="damage-form" class="form" action="/api/schaden-melden" method="post" enctype="multipart/form-data">
                    <label for="name">Name</label>
                    <input id="name" name="name" type="text" autocomplete="name" maxlength="100" required>

                    <label for="contact">E-Mail oder Telefonnummer</label>
                    <input id="contact" name="contact" type="text" autocomplete="email" maxlength="200" required>

                    <label for="location">Ort / Abschnitt</label>
                    <input id="location" name="location" type="text" maxlength="300" placeholder="z. B. XC-Trail Bruschied, kurz nach der Teufelsfelshütte" required>

                    <label for="description">Was ist kaputt?</label>
                    <textarea id="description" name="description" rows="6" maxlength="5000" required></textarea>

                    <label for="photos">Fotos <span class="form-hint">(optional, bis zu 3)</span></label>
                    <input id="photos" name="photos" type="file" accept="image/*" multiple>

                    <div class="hp-field" aria-hidden="true">
                        <label for="website">Website</label>
                        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
                    </div>

                    <p class="form-privacy">Deine Angaben gehen per E-Mail an das Trailbau-Team und werden nur für die Bearbeitung der Meldung verwendet. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>

                    <button type="submit" class="btn btn-primary">
                        <Icon name="paper-plane" />
                        <span class="btn-label">Meldung senden</span>
                    </button>
                    <p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p>
                </form>
            </div>

            <aside class="tips">
                <div class="note emergency">
                    <p><strong>Bei akuter Gefahr oder einem Unfall sofort den Notruf <a href="tel:112">112</a> wählen.</strong></p>
                </div>
                <div class="card">
                    <h2>So finden wir die Stelle schnell</h2>
                    <ul>
                        <li>Welcher Trail, und ungefähr wo? Markante Punkte wie die Teufelsfelshütte helfen.</li>
                        <li>Was genau ist passiert, und ist der Abschnitt noch fahrbar?</li>
                        <li>Ein Foto der Stelle, am besten mit etwas Umgebung.</li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>
</Base>

<script>
    // Submits to the Worker at /api/schaden-melden. Without JavaScript the form
    // posts normally and the Worker redirects back to #gesendet / #fehler.
    // With JavaScript, photos are downscaled first (this also drops EXIF/GPS data).
    const form = document.querySelector<HTMLFormElement>('#damage-form');

    if (form) {
        const MAX_PHOTOS = 3;
        const MAX_EDGE = 1600;
        const status = document.querySelector<HTMLElement>('#form-status')!;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        const buttonLabel = button.querySelector('.btn-label')!;
        const photoInput = document.querySelector<HTMLInputElement>('#photos')!;
        const success = document.querySelector<HTMLElement>('#gesendet')!;
        const failure = document.querySelector<HTMLElement>('#fehler')!;

        const showStatus = (message: string, isError = false) => {
            status.hidden = false;
            status.textContent = message;
            status.classList.toggle('is-error', isError);
        };

        photoInput.addEventListener('change', () => {
            if ((photoInput.files?.length ?? 0) > MAX_PHOTOS) {
                showStatus(`Bitte wähle höchstens ${MAX_PHOTOS} Fotos aus. Es werden nur die ersten ${MAX_PHOTOS} gesendet.`, true);
            } else {
                status.hidden = true;
            }
        });

        // Downscale to a JPEG. Falls back to the original file.
        async function shrink(file: File): Promise<File> {
            if (!file.type.startsWith('image/') || !('createImageBitmap' in window)) return file;
            try {
                const bitmap = await createImageBitmap(file);
                const scale = Math.min(1, MAX_EDGE / Math.max(bitmap.width, bitmap.height));
                const canvas = document.createElement('canvas');
                canvas.width = Math.round(bitmap.width * scale);
                canvas.height = Math.round(bitmap.height * scale);
                canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
                bitmap.close();
                const blob = await new Promise<Blob | null>(resolve => canvas.toBlob(resolve, 'image/jpeg', 0.8));
                if (!blob || blob.size >= file.size) return file;
                return new File([blob], file.name.replace(/\.[^.]+$/, '') + '.jpg', { type: 'image/jpeg' });
            } catch {
                return file;
            }
        }

        form.addEventListener('submit', async event => {
            event.preventDefault();
            success.classList.remove('is-shown');
            failure.classList.remove('is-shown');

            const data = new FormData(form);
            data.delete('photos');
            const photos = Array.from(photoInput.files ?? []).slice(0, MAX_PHOTOS);

            button.disabled = true;
            buttonLabel.textContent = photos.length ? 'Fotos werden vorbereitet …' : 'Wird gesendet …';
            status.hidden = true;

            try {
                for (const photo of photos) data.append('photos', await shrink(photo));
                buttonLabel.textContent = 'Wird gesendet …';

                const response = await fetch(form.action, {
                    method: 'POST',
                    body: data,
                    headers: { Accept: 'application/json' },
                });
                const result = await response.json().catch(() => ({}));
                if (!response.ok || !result.ok) throw new Error(result.error || 'Unbekannter Fehler');

                form.reset();
                success.classList.add('is-shown');
                if (result.skipped?.length) {
                    showStatus(`Hinweis: ${result.skipped.length} Foto(s) waren zu groß und wurden nicht mitgeschickt.`, true);
                }
                success.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (error) {
                failure.classList.add('is-shown');
                showStatus(error instanceof Error ? error.message : 'Unbekannter Fehler', true);
                failure.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } finally {
                button.disabled = false;
                buttonLabel.textContent = 'Meldung senden';
            }
        });
    }
</script>

<style>
    .report {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 3rem);
        align-items: start;
    }

    .tips {
        display: grid;
        gap: 1.25rem;
    }

    .tips h2 {
        font-size: 1.2rem;
        letter-spacing: 0;
    }

    .tips ul {
        margin: 0;
        padding-left: 1.2rem;
        color: var(--muted);
    }

    .tips li + li {
        margin-top: 0.5rem;
    }

    .emergency {
        border-left-color: var(--closed);
        background: rgba(248, 113, 113, 0.12);
    }

    .emergency a {
        color: var(--text);
    }

    .form-privacy {
        margin-top: 1rem;
        color: var(--muted);
        font-size: 0.9rem;
    }

    .form-status {
        color: var(--muted);
    }

    .form-status.is-error {
        color: #fca5a5;
    }

    /* Shown via #gesendet / #fehler (no-JS redirect) or .is-shown (JS) */
    .form-result {
        display: none;
        gap: 1rem;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        padding: 1.1rem 1.25rem;
        border-radius: var(--radius-sm);
    }

    .form-result:target,
    .form-result.is-shown {
        display: flex;
    }

    .form-result :global(.icon) {
        font-size: 1.4rem;
        margin-top: 0.1rem;
    }

    .form-result p {
        margin: 0.25rem 0 0;
    }

    .form-success {
        background: rgba(52, 211, 153, 0.12);
        border: 1px solid rgba(52, 211, 153, 0.5);
    }

    .form-success :global(.icon) {
        color: var(--open);
    }

    .form-error {
        background: rgba(248, 113, 113, 0.12);
        border: 1px solid rgba(248, 113, 113, 0.5);
    }

    .form-error :global(.icon) {
        color: var(--closed);
    }

    @media (max-width: 860px) {
        .report {
            grid-template-columns: 1fr;
        }
    }
</style>
